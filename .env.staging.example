# Use only docker-compose.staging.yml, never the production Compose file.
# Paste the immutable ghcr.io/...@sha256:... reference from candidate.json.
STAGING_IMAGE=ghcr.io/crywolf203/imessage-archive:candidate-copy-from-action-summary
STAGING_PORT=8088
# Replace both placeholders. Generate the secret once with openssl rand -hex 32.
STAGING_PASSWORD='replace-with-a-unique-staging-password'
STAGING_SECRET_KEY=replace-with-a-random-staging-session-secret
