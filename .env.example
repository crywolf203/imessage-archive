# Complete explanations, defaults, limits, and examples: README.md#configuration-reference
# Optional image pin for docker-compose.image.yml only:
# IMAGE=ghcr.io/crywolf203/imessage-archive:v4.0.1
# Leave most defaults unchanged until a manual backup/export works.
TZ=America/New_York
WEB_PORT=8087
# Login credentials. Replace the password placeholder; never deploy it unchanged.
APP_USER=aaron
APP_PASSWORD=replace-with-a-long-random-password
# Optional read-only access; blank password disables the viewer account.
VIEWER_USER=viewer
VIEWER_PASSWORD=
# Private login-session signing key, NOT a login or iPhone backup password.
# Generate once in the Unraid terminal: openssl rand -hex 32
# Paste its 64-character output below and retain it across upgrades.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
# 0 for HTTP LAN access; 1 only with a working HTTPS connection. Does not enable TLS.
COOKIE_SECURE=0
START_USBMUXD=1
LOG_LINES=300
# Advanced PDF/image settings; integer values, not thread counts or GPU options.
PDF_TIMEOUT_SECONDS=900
PDF_IMAGE_MAX_EDGE=1800
PDF_IMAGE_QUALITY=80
PDF_IMAGE_WORKERS=2
PDF_OPTIMIZE_MIN_BYTES=524288
PDF_NICE_LEVEL=5
PDF_RENDERER_PROCESSES=2
LIBRARY_CHUNK_MESSAGES=300
# Initial automation defaults; settings saved in the web app take precedence.
# Scheduling performs backups, not exports. Test a manual backup before enabling it.
SCHEDULE_ENABLED=0
SCHEDULE_INTERVAL_HOURS=24
SCHEDULE_NETWORK=1
SCHEDULE_FULL=0
# Optional receiver accepting the app's generic JSON payload; may need an adapter.
NOTIFY_WEBHOOK_URL=
NOTIFY_ON_SUCCESS=1
# 0 means keep everything. Positive ages apply when Apply retention cleanup is run.
# Retention never deletes iPhone backups; cleanup permanently deletes eligible outputs.
EXPORT_RETENTION_DAYS=0
PDF_RETENTION_DAYS=0
